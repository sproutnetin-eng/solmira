    { "source": "/problems/:id/final-upload", "destination": "/final-upload" },
    { "source": "/problems/:id", "destination": "/problem-detail" },
    { "source": "/solutions/:id", "destination": "/solution-detail" },
    { "source": "/checkout/:submissionId", "destination": "/checkout" },
    { "source": "/blogs/new", "destination": "/blog-new" },
    { "source": "/blogs/manage", "destination": "/blog-manage" },
    { "source": "/blogs/:id", "destination": "/blog-detail" },
