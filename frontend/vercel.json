{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:match*", "destination": "https://solmira.onrender.com/api/:match*" },
    { "source": "/assets/config.js", "destination": "https://solmira.onrender.com/assets/config.js" },
    { "source": "/login/student", "destination": "/login-student.html" },
    { "source": "/login/poster", "destination": "/login-poster.html" },
    { "source": "/login/mentor", "destination": "/login-mentor.html" },
    { "source": "/login/admin", "destination": "/login-admin.html" },
    { "source": "/join/verify", "destination": "/verify-otp.html" },
    { "source": "/problems/:id/submit", "destination": "/submit.html" },
    { "source": "/problems/:id/final-upload", "destination": "/final-upload.html" },
    { "source": "/problems/:id", "destination": "/problem-detail.html" },
    { "source": "/solutions/:id", "destination": "/solution-detail.html" },
    { "source": "/checkout/:submissionId", "destination": "/checkout.html" },
    { "source": "/blogs/new", "destination": "/blog-new.html" },
    { "source": "/blogs/manage", "destination": "/blog-manage.html" },
    { "source": "/blogs/:id", "destination": "/blog-detail.html" },
    { "source": "/mentor/dashboard", "destination": "/mentor-dashboard.html" },
    { "source": "/mentor/profile", "destination": "/mentor-profile.html" },
    { "source": "/mentor/connect/:notificationId", "destination": "/mentor-connect.html" },
    { "source": "/profile/:slug", "destination": "/profile.html" },
    { "source": "/teams/:id", "destination": "/team-detail.html" },
    { "source": "/poster/dashboard", "destination": "/poster-dashboard.html" },
    { "source": "/poster/post-problem", "destination": "/post-problem.html" },
    { "source": "/poster/problems/:id/edit", "destination": "/poster-problem-edit.html" },
    { "source": "/poster/problems/:id/enrollments", "destination": "/poster-enrollments.html" },
    { "source": "/poster/problems", "destination": "/poster-problems.html" },
    { "source": "/poster/solutions", "destination": "/poster-solutions.html" },
    { "source": "/admin/analytics", "destination": "/admin-analytics.html" },
    { "source": "/admin/judging", "destination": "/admin-judging.html" },
    { "source": "/admin/problems/:id/edit", "destination": "/admin-problem-edit.html" },
    { "source": "/admin/problems/:id/enrollments", "destination": "/admin-enrollments.html" },
    { "source": "/admin/problems", "destination": "/admin-problems.html" },
    { "source": "/admin/solutions", "destination": "/admin-solutions.html" },
    { "source": "/admin/payouts", "destination": "/admin-payouts.html" }
  ]
}

