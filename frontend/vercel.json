{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:match*", "destination": "https://solmira.onrender.com/api/:match*" },
    { "source": "/assets/config.js", "destination": "https://solmira.onrender.com/assets/config.js" },
    { "source": "/login/student", "destination": "/login-student" },
    { "source": "/login/poster", "destination": "/login-poster" },
    { "source": "/login/mentor", "destination": "/login-mentor" },
    { "source": "/login/admin", "destination": "/login-admin" },
    { "source": "/join/verify", "destination": "/verify-otp" },
