    { "source": "/poster/problems", "destination": "/poster-problems" },
    { "source": "/poster/solutions", "destination": "/poster-solutions" },
    { "source": "/admin/analytics", "destination": "/admin-analytics" },
    { "source": "/admin/judging", "destination": "/admin-judging" },
    { "source": "/admin/problems/:id/edit", "destination": "/admin-problem-edit" },
    { "source": "/admin/problems/:id/enrollments", "destination": "/admin-enrollments" },
    { "source": "/admin/problems", "destination": "/admin-problems" },
    { "source": "/admin/solutions", "destination": "/admin-solutions" },
    { "source": "/admin/payouts", "destination": "/admin-payouts" }
  ]
